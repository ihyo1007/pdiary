<h1 class="page-title">Ideas</h1>

<div id="ideas">
  <% @ideas.in_groups_of(3, false) do |group| %>
    <div class="row">
      <% group.each do |idea| %>
        <div class="col-md-4 my-3">
          <div class="card idea-card">

            <%= link_to idea do %>
              <%= image_tag(idea.picture_url(:thumb), class: "card-img-top") if idea.picture.present? %>
            <% end %>

            <div class="like-overlay">
              <%= button_to idea_likes_path(idea), method: :post, class: "like-overlay-btn" do %>
                👍 <%= idea.likes.count %>
              <% end %>
            </div>
            
            <h>

          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>